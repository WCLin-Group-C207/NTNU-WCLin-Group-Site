{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_commit.py",
            "if": "Bash(git commit*)",
            "timeout": 30,
            "statusMessage": "檢查 commit 內容（機密資訊 / 圖片命名規則）..."
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_commit.py",
            "if": "PowerShell(git commit*)",
            "timeout": 30,
            "statusMessage": "檢查 commit 內容（機密資訊 / 圖片命名規則）..."
          }
        ]
      }
    ]
  }
}
